{
    "name": "pixi-viewport",
    "version": "7.0.1",
    "description": "A highly configurable viewport/2D camera designed to work with pixi.js. Features include dragging, pinch-to-zoom, mouse wheel zooming, decelerated dragging, follow target, snap to point, snap to zoom, clamping, bouncing on edges, and move on mouse edges.",
    "main": "./dist/pixi_viewport.umd.cjs",
    "module": "./dist/pixi_viewport.js",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/pixi_viewport.js",
            "require": "./dist/pixi_viewport.umd.cjs"
        },
        "./dist/*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*"
        },
        "./package.json": "./package.json"
    },
    "packageManager": "pnpm@12.16.1",
    "directories": {
        "doc": "docs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite dev",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "build": "vite build --config vite.build.ts && node ./scripts/append-mixins.js",
        "docs": "vite build && typedoc",
        "docs:serve": "vite preview",
        "upgrade": "pnpm update --interactive --latest",
        "prepublishOnly": "pnpm run build && pnpm run docs",
        "lint": "eslint . --ignore-path .gitignore",
        "lint:fix": "eslint . --ignore-path .gitignore --fix",
        "prepare": "husky install && pnpm run build",
        "pre-commit": "lint-staged",
        "prepack": "pnpm run build",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p . && tsc -p docs/tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixijs-userland/pixi-viewport.git"
    },
    "keywords": [
        "PIXI",
        "pixi.js",
        "viewport",
        "zoom",
        "scroll",
        "pinch",
        "stage",
        "bounce",
        "decelerate"
    ],
    "author": "David Figatner",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/pixijs-userland/pixi-viewport/issues"
    },
    "homepage": "https://github.com/pixijs-userland/pixi-viewport#readme",
    "peerDependencies": {
        "pixi.js": ">=8"
    },
    "devDependencies": {
        "@pixi/eslint-config": "5.1.0",
        "@types/node": "24.19.2",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "@vitest/coverage-v8": "5.0.5",
        "eslint": "8.57.1",
        "husky": "8.0.3",
        "jsdom": "29.1.1",
        "lil-gui": "0.21.0",
        "lint-staged": "13.1.0",
        "pixi.js": "8.22.0",
        "typedoc": "0.28.20",
        "typedoc-github-theme": "0.4.0",
        "typedoc-plugin-mdn-links": "5.1.1",
        "typescript": "5.6.2",
        "vite": "8.3.5",
        "vite-plugin-dts": "5.1.2",
        "vitest": "5.0.5"
    }
}
